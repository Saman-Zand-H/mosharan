[Unit]
Description=Mosharan GitHub webhook receiver (auto-deploy trigger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/src/mosharan/deploy/webhook-receiver.py
# The receiver spawns detached deploy runs inside its own cgroup; stopping or
# restarting the unit must signal only the listener, never the running deploy.
KillMode=process
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
